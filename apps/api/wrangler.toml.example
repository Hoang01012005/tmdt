name = "webtmdt-store"
main = "src/index.ts"
compatibility_date = "2025-01-01"

[assets]
directory = "../web/dist"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*"]

[[d1_databases]]
binding = "DB"
database_name = "store-db"
database_id = ""

[[kv_namespaces]]
binding = "CART"
id = ""

